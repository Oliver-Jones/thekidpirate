{
    "name": "thekidpirate",
    "description": "A simple php website",
    "keywords": [
        "website", "helloworld", "php", "firsttime"
    ],
    "type": "library",
    "license": "TKP",
    "homepage": "https://gitlab.com/Oliver-Jones/thekidpirate",
    "authors": [{
        "name": "Oliver Jones",
        "email": "jonoliver1994@gmail.com",
        "homepage": "https://oliverjonesrajkuma.wixsite.com/portfolio"
    }],
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~4.0"
    },
    "support": {
        "issues": "https://gitlab.com/Oliver-Jones/thekidpirate/issues",
        "source": "https://gitlab.com/Oliver-Jones/thekidpirate"
    },
    "autoload": {
        "psr-0": {
            "src": "src/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests"]
    }
}
